# Vorlage fuer die lokale .env - NIEMALS echte Werte hier eintragen.
# Die echte .env ist in .gitignore und gehoert nicht ins Repository.
#
#   cp .env.example .env      und danach die Platzhalter ersetzen.

# ---------------------------------------------------------------------
# Fussball-Datenquellen
# ---------------------------------------------------------------------
FOOTBALL_API_KEY=<dein-football-data-org-key>
APISPORTS_KEY=<dein-api-sports-key>

# ---------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------
# Verbindungszeichenfolge der Anwendung.
DATABASE_URL=postgresql://<db-user>:<db-passwort>@127.0.0.1:5432/<db-name>

# Dieselben drei Werte einzeln - docker-compose.yml liest ausschliesslich
# diese und hat bewusst KEINEN Fallback im Repository. Sie muessen zur
# DATABASE_URL oben passen, sonst erreicht die Anwendung ihre eigene
# Datenbank nicht.
#
# Fuer eine NEUE lokale Datenbank ein zufaelliges Passwort erzeugen, z. B.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-passwort>
POSTGRES_DB=<db-name>

# ---------------------------------------------------------------------
# Sicherheit
# ---------------------------------------------------------------------
# Signiert Session-Cookies sowie Verifikations- und Reset-Links.
# Ein Wechsel macht offene Sessions und offene Links ungueltig.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<zufaelliger-langer-geheimer-wert>

# Betriebsmodus: development | testing | production
# Unbekannte Werte fuehren bewusst zum Startabbruch, statt still als
# "development" zu gelten - davon haengen Secure-Cookies und der echte
# Mailversand ab.
FOOTSIM_ENV=development

# Anzahl vertrauenswuerdiger Reverse-Proxy-Hops vor der Anwendung.
# 0 = kein Proxy (lokale Entwicklung).
# 1 = genau ein nginx davor, der X-Forwarded-For selbst setzt.
# Nur erhoehen, wenn wirklich eine weitere vertrauenswuerdige Ebene
# existiert - sonst darf sich ein Client seine IP selbst aussuchen und
# das Rate Limiting umgehen.
FOOTSIM_TRUSTED_PROXY_HOPS=0

# Speicher fuer Flask-Limiter. Standard ist memory:// (prozesslokal, je
# Gunicorn-Worker eigener Zaehler). Die harte Obergrenze uebernimmt in
# Produktion nginx (siehe ops/nginx-footsim.conf.reference). Nur setzen,
# wenn tatsaechlich ein geteilter Speicher zur Verfuegung steht.
# FOOTSIM_RATELIMIT_STORAGE_URI=memory://

# ---------------------------------------------------------------------
# E-Mail
# ---------------------------------------------------------------------
RESEND_API_KEY=<dein-resend-key>
MAIL_DEFAULT_SENDER=FootSim <noreply@example.com>
BASE_URL=http://127.0.0.1:5000

# 'true' = Mails nur auf der Konsole ausgeben (Entwicklung).
# 'false' = echter Versand ueber Resend.
# Ohne Angabe: in Produktion echt, sonst Mock.
MAIL_MOCK=true

# -----------------------------------------------------------------------------
# ANDROID - DIGITAL ASSET LINKS  (optional, nur fuer die Play-Veroeffentlichung)
# -----------------------------------------------------------------------------
#
# SHA-256-Fingerabdruecke der Signaturzertifikate der Android-App
# (Paket-ID de.footsim.app). Sie erscheinen unter
# /.well-known/assetlinks.json und belegen Android gegenueber, dass
# Domain und App zusammengehoeren. Ohne sie laeuft die App mit
# Adressleiste statt im Vollbild.
#
# Format je Wert: 32 Hexpaare, durch Doppelpunkte getrennt.
# Mehrere Fingerabdruecke durch Komma trennen - waehrend der Testphase
# muessen der lokale Upload-Key UND der App-Signing-Key von Google
# gleichzeitig gelten.
#
# Der Fingerabdruck selbst ist OEFFENTLICH und kein Geheimnis; er steht
# in jeder installierten App. Geheim bleiben Keystore, privater
# Schluessel und Passwoerter - die gehoeren niemals in eine Datei des
# Projekts.
#
# Ist die Variable leer, antwortet die Route mit 404 statt eine leere
# oder erfundene Vertrauensbeziehung zu veroeffentlichen.
#
# Den echten Wert liefert die Play Console unter "Setup -> App-Signatur".
#
# Hier steht bewusst ein Platzhalter in spitzen Klammern und KEIN Wert,
# der wie ein Fingerabdruck aussieht - ein solcher wuerde irgendwann
# versehentlich uebernommen. Die Formatpruefung der Route weist den
# Platzhalter ab und antwortet mit 404, also genau wie bei einer
# fehlenden Konfiguration.
ANDROID_ASSETLINKS_SHA256=<sha256-fingerabdruecke-kommagetrennt>
