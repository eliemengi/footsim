# Football API Keys (Get from providers)
FOOTBALL_API_KEY=your_key_here
APISPORTS_KEY=your_key_here

# Database Configuration
DATABASE_URL=postgresql://footsim_user:footsim_pass@localhost:5432/footsim_db

# Security
SECRET_KEY=replace-with-a-secure-random-secret

# Email Configuration
RESEND_API_KEY=
MAIL_DEFAULT_SENDER=FootSim <noreply@footsim.de>
BASE_URL=https://footsim.de

# Set to 'false' to enable real email sending via Resend in local development for End-to-End Testing.
# Default is 'true' in development (uses console mock), and 'false' in production.
MAIL_MOCK=true
