.venv/
# Zusaetzliche Testumgebungen (z. B. .venv312 fuer die Python-3.12-Pruefung).
# Muster statt Einzeleintrag, damit eine neue Umgebung nie versehentlich
# getrackt wird.
.venv*/
__pycache__/
.env
_snippets/

# Laufzeit-Cache: gehoert nicht ins Repo, wird zur Laufzeit erzeugt
data/cache/

# Spieler-Referenzdaten: gross, werden per refresh_players.py erzeugt.
# Der daraus berechnete Perzentil-Snapshot unter data/percentiles/ gehoert
# dagegen ins Repo, damit er nach dem Deployment sofort vorliegt.
data/player_pool/

# Zeitgestempeltes Snapshot-Archiv (data/snapshots/). Waechst mit jedem
# Lauf und gehoert deshalb nicht ins Repo - es ist eine lokal bzw. auf
# dem Server wachsende Datensammlung, kein auszulieferndes Artefakt.
# ACHTUNG: Damit bleibt gesammelte Verfuegbarkeitshistorie auf dem Host,
# auf dem sie entstanden ist. Vor der ML-Phase ist zu entscheiden, wie
# diese Daten zusammengefuehrt und gesichert werden.
data/snapshots/

# UEFA-Koeffizienten-Rohdaten fuer Big Games (data/big_games/). Manuell
# aus UEFA-Screenshots erfasst - bleibt bewusst server-seitig und
# ungeteilt, das Frontend darf nie die vollen Snapshots erhalten.
data/big_games/

# Local AI master context - never commit
# FOOTSIM � CHATGPT ELITE MASTER-ZU.txt
FOOTSIM_ELITE_MASTER_HANDOVER_SUMMARY.md
\# FOOTSIM � CHATGPT ELITE MASTER-ZU.txt
FOOTSIM_CHATGPT_ELITE_MASTER_CONTEXT.txt

# Local Database
pgdata/
